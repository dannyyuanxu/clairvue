# Required. Get a key at https://console.mistral.ai/ — used for both embeddings and generation.
MISTRAL_API_KEY=

# Mistral embedding model. mistral-embed is the only embedding model Mistral offers; changing
# this requires rebuilding the vector index (every chunk's metadata is stamped with the model
# that embedded it, so a mismatch is detectable rather than silently wrong).
EMBEDDING_MODEL=mistral-embed

# Mistral chat model used for claim decomposition, assessment, and peer comparison.
# mistral-small-latest is cheap/fast for development; swap to a larger model (e.g.
# mistral-medium-3-5) for demo-day quality — this is a one-line change, see src/llm_client.py.
LLM_MODEL=mistral-small-latest

# Local ChromaDB persistence directory. In Colab, point this at a Google Drive path so the
# index survives across sessions instead of being rebuilt from scratch every time.
CHROMA_PERSIST_DIR=./data/processed/chroma_db

# Required only for data ingestion (scripts/download_filings.py, src/metrics.py). SEC EDGAR's
# fair-access policy requires a descriptive User-Agent with a real, reachable contact —
# requests without one are rate-limited or blocked. Format: "Your Name your.email@example.com"
SEC_USER_AGENT=[First Name] [Last Name] [email]
